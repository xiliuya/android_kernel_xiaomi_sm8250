# 完全支持 crun 容器运行时的内核配置 (Android 4.19 最终完整版)

# IPC 机制
CONFIG_SYSCTL=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# 核心命名空间支持
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_CGROUP_NS=y               # Cgroup 视图隔离，Cgroup v2 必须
CONFIG_USER_NS=y                 # Rootless 容器核心，修复 Docker unsafe procfs 错误

# Seccomp 与安全密钥支持
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_KEYS=y                    # 容器密钥环隔离（Keyrings）

# 控制组支持 (Cgroups v1 & v2)
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y           # 关键：修复 crun/docker 容器 CPU 配额限制失效问题
CONFIG_CPUSETS=y                 # 补全 CPU 绑核与 Cgroup v2 cpuset 控制器
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_CPUACCT=y          # 容器 CPU 使用率统计
CONFIG_BLK_CGROUP=y              # 块设备控制组基础
CONFIG_BLK_DEV_THROTTLING=y      # 限制容器磁盘读写 IOPS / 带宽

# Cgroup v2 eBPF 支持（crun 依赖此项在 Cgroup v2 下限制设备访问）
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y

# 设备文件系统支持
CONFIG_DEVTMPFS=y

# Overlay & Ext4 文件系统支持
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS=y                 # Ext4 文件系统主体支持
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# 固件加载支持
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y
CONFIG_FW_LOADER_COMPRESS=y

# Droidspaces 网络隔离与 IPv4 防火墙 (基于传统 iptables/xtables)
CONFIG_NET_NS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_NETFILTER=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_MANGLE=y            # 补全 mangle 表，避免高级网络/DNS重定向报错
CONFIG_IP_NF_RAW=y               # 补全 raw 表
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REDIRECT=y  # 端口重定向与透明代理支持
CONFIG_NETFILTER_XT_MARK=y       # 数据包 MARK 标记支持
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NF_CONNTRACK_NETLINK=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y

# IPv6 网络与 NAT 支持
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_RAW=y
CONFIG_IP6_NF_NAT=y              # 修复 IPv6 容器无法连接外网
CONFIG_IP6_NF_TARGET_MASQUERADE=y # 修复 IPv6 地址伪装缺失

# 针对 Android 4.19 显式禁用 nftables（避免源码补全不全导致编译失败及 netd 规则冲突）
# CONFIG_NF_TABLES is not set
# CONFIG_NFT_NAT is not set
# CONFIG_NFT_MASQ is not set
# CONFIG_NFT_CT is not set
# CONFIG_NFT_FIB is not set
# CONFIG_NFT_FIB_IPV4 is not set
# CONFIG_NFT_FIB_IPV6 is not set

# 虚拟网络驱动扩展（允许容器直接绑定独立 IP 网卡）
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y

# 旧版兼容
CONFIG_NF_CONNTRACK_IPV4=y
CONFIG_NF_NAT_IPV4=y
CONFIG_IP_NF_NAT=y

# 在旧内核上禁用此选项以使互联网正常工作
CONFIG_ANDROID_PARANOID_NETWORK=n
